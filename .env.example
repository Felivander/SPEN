# Optional. Point this at your deployed /api/parse endpoint to keep the Groq
# key server-side. Leave it unset to let each device store its own key in
# Settings and call Groq directly.
VITE_LLM_PROXY_URL=

# Server-side only — read by api/parse.js, never bundled into the client.
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Supabase integration for Google OAuth & Cloud database sync
# Get these in your Supabase project settings -> API (https://supabase.com)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
